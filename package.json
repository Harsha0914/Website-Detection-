{
  "name": "websitedetection",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run backend\" \"npm run frontend\"",
    "dev:all": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run backend\" \"npm run frontend\"",
    "web": "npm --prefix frontend run dev",
    "dev": "npm --prefix frontend run dev",
    "frontend": "npm --prefix frontend run dev",
    "backend": "cd backend && venv\\Scripts\\uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "server": "cd backend && venv\\Scripts\\uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:8001",
    "build": "cd frontend && npm install && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "wrangler": "^3.107.0"
  }
}
