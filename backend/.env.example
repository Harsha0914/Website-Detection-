# ─────────────────────────────────────────────────────────────
#  Nearby Shop Website Presence Detection Platform – Backend
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://shopuser:shoppassword@localhost:5432/shopdb

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Google Places API ─────────────────────────────────────────
# Get your key at: https://console.cloud.google.com/
# Enable: Places API (New), Maps JavaScript API, Geocoding API
GOOGLE_PLACES_API_KEY=your-google-places-api-key-here

# Set to "true" to use mock data instead of real Google Places API
USE_MOCK_PLACES=false

# ── Gemini AI (for chat suggestions) ─────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Set to "true" to use rule-based chat instead of Gemini AI
USE_RULE_BASED_CHAT=false

# ── App Settings ──────────────────────────────────────────────
APP_NAME=ShopPresence
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Website Analysis ──────────────────────────────────────────
WEBSITE_CHECK_TIMEOUT_SECONDS=10
MAX_REDIRECT_FOLLOW=5
